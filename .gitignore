# Android 标准忽略
*.iml
.gradle
/local.properties
/.idea/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
*.hprof

# App 构建产物
app/build/
# Room schema（app/schemas/）要入库：迁移靠它在编译期校验，下次构建生成后随代码提交。

# 密钥与凭据 —— 绝不进仓库（CI 用 GitHub Actions Secrets）
*.jks
*.keystore
*.p12
*.pem
# v2.0.7 例外：ISRG Root X1 是公开的根证书（不是密钥/凭据），
# 旧系统播 Let's Encrypt 流地址靠它握手，必须入库，否则 CI 检出的
# 代码里没有它、应用启动时读不到 res/raw。
!app/src/main/res/raw/isrg_root_x1.pem
*.key
*.keystore
.env
*secret*
*password*
keystore*.properties
signing.properties
